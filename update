#!/bin/sh
set -eu
if id -u | grep -qx 0; then :; else echo 'SKYDNE UPDATE BRIDGE FAILED: root privileges are required' >&2; exit 1; fi
command -v python3 >/dev/null 2>&1 || { echo 'SKYDNE UPDATE BRIDGE FAILED: python3 is required' >&2; exit 1; }
umask 077
exec python3 - <<'SKYDNE_UPDATE_BRIDGE_PYTHON'
#!/usr/bin/env python3
"""One-time, signed bridge for pre-update Core installations."""
import hashlib, importlib.util, json, os, shutil, subprocess, sys, tarfile, tempfile, urllib.request
from pathlib import Path

BASE_URL = "https://install.skydne.com/releases/1.0.7"
ARCHIVE = "skydne-eye-1.0.7-amd64.tar.gz"
METADATA = "skydne-eye-1.0.7-amd64.metadata.json"
SIGNATURE = "skydne-eye-1.0.7-amd64.metadata.sig"
CONFIG = Path("/etc/skydne-eye"); STATE = Path("/var/lib/skydne-eye")

def fail(message): raise SystemExit("SKYDNE UPDATE BRIDGE FAILED: " + message)
def fetch(url, path):
    if not url.startswith("https://"): fail("unsafe release URL")
    with urllib.request.urlopen(url, timeout=120) as response, Path(path).open("wb") as output: shutil.copyfileobj(response, output)
def load(name, path, search):
    spec=importlib.util.spec_from_file_location(name,path); module=importlib.util.module_from_spec(spec)
    sys.path.insert(0,str(search)); spec.loader.exec_module(module); sys.path.pop(0); return module

def verify_envelope(metadata, signature, public_key):
    data=json.loads(Path(metadata).read_bytes())
    canonical=(json.dumps(data,sort_keys=True,separators=(",",":"),ensure_ascii=True)+"\n").encode()
    if Path(metadata).read_bytes()!=canonical: fail("release metadata is not canonical")
    result=subprocess.run(["openssl","pkeyutl","-verify","-pubin","-inkey",str(public_key),"-rawin","-in",str(metadata),"-sigfile",str(signature)],capture_output=True)
    if result.returncode or data.get("format")!="skydne-bundle-envelope-v1": fail("release signature verification failed")
    return data

def main():
    if os.geteuid()!=0: fail("root privileges are required")
    state=STATE/"installation.json"
    if not state.is_file(): fail("no existing SKYDNE installation detected")
    installed=json.loads(state.read_text())
    if installed.get("core_version") != "1.0.5": fail("bridge accepts only Core 1.0.5")
    with tempfile.TemporaryDirectory(prefix="skydne-bridge-") as temp:
        root=Path(temp); archive=root/ARCHIVE; metadata=root/METADATA; signature=root/SIGNATURE; key=root/"release-authority-v1.pem"
        for filename, destination in ((ARCHIVE,archive),(METADATA,metadata),(SIGNATURE,signature),("release-authority-v1.pem",key)): fetch(BASE_URL+"/"+filename,destination)
        envelope=verify_envelope(metadata,signature,key)
        if envelope.get("version")!="1.0.7" or envelope.get("bundle_file")!=ARCHIVE: fail("release metadata mismatch")
        if hashlib.sha256(archive.read_bytes()).hexdigest()!=envelope["sha256"]: fail("release checksum mismatch")
        expanded=root/"expanded"; expanded.mkdir(mode=0o700)
        with tarfile.open(archive,"r:gz") as package: package.extractall(expanded,filter="data")
        candidates=[item for item in expanded.iterdir() if item.is_dir()]
        if len(candidates)!=1: fail("release payload is incomplete")
        bundle=candidates[0]; host=load("production_host",bundle/"core/deploy/production_host.py",bundle/"core/deploy")
        mount=load("update_cli",bundle/"core/deploy/update_cli.py",bundle/"core/deploy").master_usb()
        backup=host.transaction_backup(Path("/var/backups/skydne-eye"),CONFIG/"backup-passphrase","1.0.5")
        args=[sys.executable,str(bundle/"core/deploy/production_host.py"),"--production","--activate","--bundle",str(bundle),"--site",str(CONFIG/"site.toml"),"--key-mount",str(mount),"--backup",backup["path"],"--backup-key",str(CONFIG/"backup-passphrase"),"--approved-commit",envelope["commit"]]
        env=dict(os.environ,SKYDNE_INSTALLER_ROOT=str(bundle/"core"),PYTHONPATH=str(bundle/"core/deploy"),PYTHONDONTWRITEBYTECODE="1")
        result=subprocess.run(args,env=env,timeout=7200)
        if result.returncode: fail("signed activation failed; rollback was attempted")
        print(json.dumps({"status":"PASS","previous":"1.0.5","current":"1.0.7","recordings_preserved":True}))
if __name__=="__main__": main()

SKYDNE_UPDATE_BRIDGE_PYTHON
